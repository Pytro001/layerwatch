# Optional: Claude on Amazon Bedrock writes the human readable incident note for a STOP.
# Without it LayerWatch writes a template note. It never makes a measurement.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
AWS_REGION=us-east-1
BEDROCK_CLAUDE_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional overrides
LAYERWATCH_ONNX=models/layerwatch_unet.onnx
LAYERWATCH_MODE=fused
